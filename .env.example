NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media_crm

AUTH_SECRET=replace-with-secure-random-string
AUTH_TRUST_HOST=true

FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_VERIFY_TOKEN=replace-with-facebook-verify-token

REDIS_URL=redis://localhost:6379

# Optional media storage
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
